# Copy to .env and adjust if needed (defaults work for local practice)
# Used by docker-compose.yml

# Vault dev mode root token — only used locally, never in production
VAULT_TOKEN=root
VAULT_ADDR=http://localhost:8200

# PostgreSQL credentials for the Vault dynamic-creds demo
POSTGRES_DB=payments
POSTGRES_USER=vault_admin
POSTGRES_PASSWORD=vault_admin_pass

# LocalStack endpoint for terraform apply practice
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
