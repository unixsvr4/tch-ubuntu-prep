# Ansible inventory — Docker practice target
# The ansible-target container runs sshd on port 2222 (host) → 22 (container).
# `make up` starts it; `make ansible-ping` tests connectivity.

[payment_servers]
ansible-target ansible_host=localhost ansible_port=2222 ansible_user=root

[payment_servers:vars]
# These would normally come from encrypted group_vars/prod/vault.yml
# For practice, they're unencrypted here. See group_vars/prod/vault_example.yml
# for the ansible-vault format.
ansible_python_interpreter=/usr/bin/python3
