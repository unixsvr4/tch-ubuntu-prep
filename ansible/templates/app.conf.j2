# {{ app_name }} application configuration
# Generated by Ansible — do not edit manually
# Environment: {{ inventory_hostname }}

[database]
# Database credentials are NOT stored here.
# They are injected by Vault Agent at runtime as environment variables.
# Vault issues a unique credential per app instance with 1h TTL.
host = payments-db.internal
port = 5432
name = payments
# VAULT_DB_USER / VAULT_DB_PASSWORD set by vault-agent-template

[api]
# API keys stored in AWS Secrets Manager — fetched at startup via IAM role
# Populated from secretsmanager:tch/payments/stripe-api-key
stripe_secret = ""
port = {{ app_port | default(8443) }}

[security]
# TLS cert paths (managed by Vault PKI engine, rotated automatically)
tls_cert = /etc/payments/certs/server.crt
tls_key  = /etc/payments/certs/server.key
# PCI-DSS 4.2.1: TLS 1.2 minimum
tls_min_version = TLS1.2

[logging]
# Structured JSON logging — shipped to centralized SIEM
level  = info
format = json
# Do NOT log raw request bodies — may contain PAN (card numbers)
# PCI-DSS 3.4: PAN must not be stored unnecessarily
log_request_body = false
