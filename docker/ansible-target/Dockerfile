# ============================================================
# Ansible practice target — Ubuntu 22.04 with sshd
# ============================================================
# Purpose: run Ansible hardening playbooks against a real Linux container.
# Built by: `make setup` (which generates the demo SSH key first)
#
# What's installed:
#   openssh-server    — sshd for Ansible to connect
#   python3           — required by all Ansible modules
#   python3-psycopg2  — required by ansible postgresql_user module (secrets-good.yml)
#   auditd            — target for the hardening playbook (PCI-DSS req 10)
#   sudo              — for become: true in playbooks
#
# Connect: ssh -i ansible/demo_key -p 2222 root@localhost
# ============================================================

FROM ubuntu:22.04

# Avoid interactive prompts during apt-get
ENV DEBIAN_FRONTEND=noninteractive

# Install everything the hardening playbook will manage
RUN apt-get update && apt-get install -y --no-install-recommends \
    openssh-server \
    python3 \
    python3-apt \
    python3-psycopg2 \
    sudo \
    auditd \
    audispd-plugins \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create sshd runtime directory (required for sshd to start)
RUN mkdir -p /var/run/sshd && chmod 0755 /var/run/sshd

# Configure SSH for Ansible access:
#   PermitRootLogin yes         — the hardening playbook will change this to "no"
#   PubkeyAuthentication yes    — key-based auth (more secure than password)
#   PasswordAuthentication no   — force key auth from the start
#
# NOTE: root login is ENABLED here so Ansible can connect before hardening runs.
# After running the hardening playbook, root login will be disabled.
# This demonstrates the BEFORE state that the playbook fixes.
RUN sed -i 's/#\?PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#\?PubkeyAuthentication.*/PubkeyAuthentication yes/' /etc/ssh/sshd_config && \
    sed -i 's/#\?PasswordAuthentication.*/PasswordAuthentication no/' /etc/ssh/sshd_config && \
    # Keep strict modes for key security
    echo "StrictModes yes" >> /etc/ssh/sshd_config

# Generate SSH host keys (needed for sshd to start)
RUN ssh-keygen -A

# Add the demo SSH public key for Ansible to connect
# This file is generated by `make setup` and copied here before `docker compose build`
RUN mkdir -p /root/.ssh && chmod 700 /root/.ssh
COPY authorized_keys /root/.ssh/authorized_keys
RUN chmod 600 /root/.ssh/authorized_keys && \
    chown -R root:root /root/.ssh

# Create the payments service account that the hardening playbook creates
# (Pre-creating avoids playbook failure if adduser is slow in container)
RUN useradd -r -s /usr/sbin/nologin -d /opt/payments -m payments 2>/dev/null || true

# Create directories the playbook writes to
RUN mkdir -p /etc/payments /etc/vault-agent /etc/audit/rules.d

# Port 22 — mapped to 2222 on the host in docker-compose.yml
EXPOSE 22

# Start SSH daemon in foreground (Docker needs foreground process)
CMD ["/usr/sbin/sshd", "-D", "-e"]
